<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Emulator surface will be added programmatically or by library -->
    <FrameLayout
        android:id="@+id/emulator_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Transparent control overlay -->
    <RelativeLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Left / Right -->
        <LinearLayout
            android:id="@+id/dpad_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="40dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_left"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:text="@string/btn_left"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.4" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:text="@string/btn_right"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.4" />
        </LinearLayout>

        <!-- Jump / Run -->
        <LinearLayout
            android:id="@+id/action_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="40dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_run"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:text="@string/btn_run"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.4" />

            <Button
                android:id="@+id/btn_jump"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="14dp"
                android:text="@string/btn_jump"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.4" />
        </LinearLayout>

        <!-- Top bar: Select / Start / Pause -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_select"
                android:layout_width="60dp"
                android:layout_height="34dp"
                android:text="@string/btn_select"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.5" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="60dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_start"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.5" />

            <Button
                android:id="@+id/btn_pause"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:text="@string/btn_pause"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/transparent_button"
                android:alpha="0.6" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Pause Menu Overlay -->
    <FrameLayout
        android:id="@+id/pause_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/pause_panel_bg"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause_title"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_resume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/resume"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_save_cp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/save_checkpoint"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_load_cp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/load_checkpoint"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF9800"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/exit_game"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
